<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>dotnet-aicraft</AssemblyName>
    <RootNamespace>DotnetAICraft</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- dotnet tool metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-aicraft</ToolCommandName>
    <PackageId>dotnet-aicraft</PackageId>
    <Version>0.1.0</Version>
    <Authors>Artur Gawrylak</Authors>
    <Description>Semantic .NET code analysis for AI agents — find references, rename symbols, explore call hierarchy using Roslyn.</Description>
    <PackageTags>roslyn;ai;agent;refactoring;codeanalysis;mcp;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/glakartur/dotnet-aicraft</PackageProjectUrl>
    <RepositoryUrl>https://github.com/glakartur/dotnet-aicraft</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Reproducible package metadata -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AicraftDaemonProjectPath>$(MSBuildThisFileDirectory)../AICraftDaemon/AICraftDaemon.csproj</AicraftDaemonProjectPath>
    <AicraftDaemonBuildDir>$(MSBuildThisFileDirectory)../AICraftDaemon/bin/$(Configuration)/$(TargetFramework)/</AicraftDaemonBuildDir>
    <AicraftDaemonPublishDir>$(IntermediateOutputPath)AicraftDaemonPublish/</AicraftDaemonPublishDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DotnetAICraft.Tests</_Parameter1>
    </AssemblyAttribute>

    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AICraftDaemon/AICraftDaemon.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../DotnetAICraft.Core/DotnetAICraft.Core.csproj" />

    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />

    <!-- Source Link -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyAicraftDaemonToOutput" AfterTargets="Build" Condition="'$(SkipAicraftDaemonBuildTargets)' != 'true'">
    <ItemGroup>
      <AicraftDaemonArtifacts Include="$(AicraftDaemonBuildDir)aicraft-daemon*" />
    </ItemGroup>

    <Copy SourceFiles="@(AicraftDaemonArtifacts)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAicraftDaemonToPublish" AfterTargets="Publish" Condition="'$(SkipAicraftDaemonBuildTargets)' != 'true'">
    <ItemGroup>
      <AicraftDaemonPublishedArtifacts Include="$(AicraftDaemonBuildDir)aicraft-daemon*" />
    </ItemGroup>

    <Copy SourceFiles="@(AicraftDaemonPublishedArtifacts)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeAicraftDaemonInPackage" BeforeTargets="GenerateNuspec" Condition="'$(SkipAicraftDaemonBuildTargets)' != 'true'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(AicraftDaemonBuildDir)aicraft-daemon*">
        <PackagePath>tools/$(TargetFramework)/any/%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
